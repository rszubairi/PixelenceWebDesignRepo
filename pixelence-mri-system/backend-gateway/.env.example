# Convex
CONVEX_URL=https://your-deployment.convex.cloud

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=your-smtp-password
EMAIL_FROM=no-reply@pixelenceai.com

# QMS e-signature HMAC secret (keep this secret, rotate if compromised)
QMS_HMAC_SECRET=change-this-to-a-long-random-secret

# AI Copilot (Claude — used by Convex qms/ai.ts actions)
ANTHROPIC_API_KEY=sk-ant-...

# ML service
ML_SERVICE_URL=http://localhost:8000

# JWT
JWT_SECRET=change-this-to-a-long-random-secret

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
